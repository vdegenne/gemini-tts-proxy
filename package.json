{
	"name": "@vdegenne/gemini-tts-proxy",
	"version": "0.1.25",
	"description": "A self-hosted Gemini proxy with caching and a browser client.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/vdegenne/gemini-tts-proxy.git"
	},
	"homepage": "https://github.com/vdegenne/gemini-tts-proxy#readme",
	"bugs": {
		"url": "https://github.com/vdegenne/gemini-tts-proxy/issues"
	},
	"exports": {
		".": {
			"types": "./lib/tts.d.ts",
			"import": "./lib/tts.js",
			"default": "./lib/tts.js"
		},
		"./core": {
			"types": "./lib/core.d.ts",
			"import": "./lib/core.js",
			"default": "./lib/core.js"
		}
	},
	"bin": {
		"gemini-tts-proxy": "./lib/index.js"
	},
	"files": [
		"./lib/"
	],
	"scripts": {
		"build": "wireit",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@snar/lit": "^1.8.1",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"wireit": "^0.15.0"
	},
	"dependencies": {
		"@google/genai": "^3.3.0",
		"@hono/node-server": "^2.1.8",
		"dotenv": "^18.0.10",
		"firebase-admin": "^14.5.1",
		"hono": "^4.13.18"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src/"
			],
			"output": [
				"./lib/"
			]
		}
	}
}
